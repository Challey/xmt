<div class="xmt-short-detail" data-nid="{{ card.nid }}" data-xmt-theme-root>
  <div class="xmt-wechat-tip" data-xmt-wechat-tip hidden>
    <p>微信内可能无法直接打开本站。请点右上角 <strong>···</strong> → <strong>在浏览器打开</strong>，或复制链接。</p>
    <div class="xmt-wechat-tip__actions">
      <button type="button" class="xmt-short__btn xmt-short__btn--primary" data-xmt-copy-share>复制本页链接</button>
      <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ wechat_help_url }}">打开说明</a>
    </div>
  </div>

  <div class="xmt-short-detail__nav">
    <a class="xmt-short-detail__back" href="{{ feed_url }}">← 返回速览</a>
    <a class="xmt-short-detail__back" href="{{ immerse_url }}">继续信流</a>
    <a class="xmt-short-detail__back" href="/trusted/search">搜索</a>
    <button type="button" class="xmt-short__mode-btn xmt-short__theme-btn" data-xmt-theme-toggle aria-label="{{ '切换白天 / 黑夜'|t }}" title="{{ '白天 / 黑夜'|t }}">
      <span data-xmt-theme-label>白天</span>
    </button>
  </div>

  <div class="xmt-short-detail__meta">
    <span class="xmt-trust-badge {{ card.badge_class }}">{{ card.badge_label }}</span>
    {% if card.source_name %}
      {% if card.source_feed_url %}
        <a href="{{ card.source_feed_url }}">{{ card.source_name }}</a>
      {% else %}
        <span>{{ card.source_name }}</span>
      {% endif %}
    {% endif %}
    {% if card.domain_label %}<span>{{ card.domain_label }}</span>{% endif %}
    <span>{{ card.created_label }}</span>
  </div>

  <h1 class="xmt-short-detail__title">{{ card.title }}</h1>
  <p class="xmt-short-detail__prov">{{ card.provenance_note }}</p>

  <section class="xmt-short-detail__brief">
    <h2>关键摘要</h2>
    <p>{{ card.brief }}</p>
    {% if card.keypoints %}
      <ul>
        {% for point in card.keypoints %}
          <li>{{ point }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    <p class="xmt-short-detail__engine">摘要引擎：{{ card.engine == 'ai' ? 'AI' : '抽取' }}</p>
  </section>

  <section class="xmt-short-detail__body">
    <h2>正文提要</h2>
    {% if card.body_html %}
      <div class="xmt-short-detail__html">{{ card.body_html|raw }}</div>
    {% else %}
      <p>{{ card.body_text }}</p>
    {% endif %}
  </section>

  <div class="xmt-short-detail__cta">
    {% if card.source_url %}
      <a class="xmt-short__btn xmt-short__btn--primary" href="{{ card.source_url }}" target="_blank" rel="noopener noreferrer">打开官方原文</a>
    {% endif %}
    {% if card.publisher_url %}
      <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ card.publisher_url }}">查看发布主体</a>
    {% endif %}
    <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ card.node_url }}">站点原文页</a>
    <a class="xmt-short__btn xmt-short__btn--ghost" href="/trusted">可信分区</a>
    {% if card.source_feed_url %}
      <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ card.source_feed_url }}">本信源更多</a>
    {% endif %}
    <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ today_url|default('/read/today') }}">今日简报</a>
    <button type="button" class="xmt-short__btn xmt-short__btn--ghost" data-xmt-copy-share data-url="{{ share_url }}">复制分享链接</button>
    <button type="button" class="xmt-short__btn xmt-short__btn--ghost" data-xmt-copy-short data-url="{{ share_url }}" title="绝对短链 /read/{nid}">复制短链</button>
    <button type="button" class="xmt-short__btn xmt-short__btn--ghost" data-xmt-copy-brief data-brief="{{ card.brief }}">复制摘要</button>
    <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ share_image_url }}" target="_blank" rel="noopener noreferrer">分享图</a>
    <button type="button" class="xmt-short__btn xmt-short__btn--ghost" data-xmt-later data-nid="{{ card.nid }}" data-title="{{ card.title }}" data-url="{{ card.detail_url }}">稍后再看</button>
    <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ rss_url }}" type="application/rss+xml" rel="alternate">RSS</a>
    <button type="button" class="xmt-short__btn xmt-short__btn--ghost" data-xmt-copy-rss data-rss="{{ rss_url }}">复制 RSS</button>
    <a class="xmt-short__btn xmt-short__btn--ghost" href="/read/later">稍后再看列表</a>
    {% if official_media_url %}
      <a class="xmt-short__btn xmt-short__btn--ghost" href="{{ official_media_url }}">官媒栏目</a>
    {% endif %}
  </div>

  {% if prev or next %}
    <nav class="xmt-short-detail__pager" aria-label="相邻短闻">
      {% if prev %}
        <a class="xmt-short-detail__pager-link xmt-short-detail__pager-link--prev" href="{{ prev.detail_url }}">
          <span class="xmt-short-detail__pager-label">上一篇 · k · ↑</span>
          <span class="xmt-short-detail__pager-title">{{ prev.title }}</span>
        </a>
      {% else %}
        <span class="xmt-short-detail__pager-link xmt-short-detail__pager-link--empty"></span>
      {% endif %}
      {% if next %}
        <a class="xmt-short-detail__pager-link xmt-short-detail__pager-link--next" href="{{ next.detail_url }}">
          <span class="xmt-short-detail__pager-label">下一篇 · j · ↓</span>
          <span class="xmt-short-detail__pager-title">{{ next.title }}</span>
        </a>
      {% endif %}
    </nav>
    <p class="xmt-short__hint" aria-hidden="true">j/k 上下篇 · c 复制链接 · y 短链 · s 信源 · m/u 已读 · l 稍后 · o 原文 · b 摘要 · t 今日 · i 沉浸 · r RSS · f,/ 搜索 · g 官媒</p>
  {% endif %}

  {% if related %}
    <section class="xmt-short-detail__related" aria-label="相关短闻">
      <h2>相关短闻（同信源优先）</h2>
      <ul class="xmt-short-detail__related-list">
        {% for item in related %}
          <li>
            <a href="{{ item.detail_url }}">
              <span class="xmt-trust-badge {{ item.badge_class }}">{{ item.badge_label }}</span>
              <span class="xmt-short-detail__related-title">{{ item.title }}</span>
            </a>
            {% if item.domain_label %}<span class="xmt-short-detail__related-meta">{{ item.domain_label }}</span>{% endif %}
            {% if item.immerse_url %}
              <a class="xmt-short-detail__related-share" href="{{ item.immerse_url }}">沉浸</a>
            {% endif %}
            {% if item.share_image_url %}
              <a class="xmt-short-detail__related-share" href="{{ item.share_image_url }}" target="_blank" rel="noopener noreferrer">分享图</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <p class="xmt-short__hint" aria-hidden="true">j/k 上下篇 · c 复制 · s 信源 · m/u 已读 · l 稍后 · o 原文 · b 摘要 · t 今日 · i 沉浸 · r RSS · f,/ 搜索 · g 官媒</p>
</div>
