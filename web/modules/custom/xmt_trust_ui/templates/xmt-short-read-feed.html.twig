<div class="xmt-short xmt-short--{{ mode }}" data-api="{{ api_url }}" data-level="{{ level }}" data-mode="{{ mode }}" data-domain="{{ domain }}" data-focus="{{ focus }}" data-xmt-theme-root{% if mode == 'immerse' %} data-immerse="1"{% endif %}>
  <div class="xmt-wechat-tip" data-xmt-wechat-tip hidden>
    <p>微信内可能无法直接打开本站。请点右上角 <strong>···</strong> → <strong>在浏览器打开</strong>，或复制链接后用系统浏览器访问。</p>
    <div class="xmt-wechat-tip__actions">
      <button type="button" class="xmt-short__btn xmt-short__btn--primary" data-xmt-copy-share>复制本页链接</button>
      <a class="xmt-short__btn xmt-short__btn--ghost" href="/help/wechat">打开说明</a>
    </div>
  </div>

  <header class="xmt-short__top">
    <div class="xmt-short__brand-wrap">
      <p class="xmt-short__eyebrow">XMT</p>
      <div class="xmt-short__brand">短闻</div>
      {% if mode == 'browse' %}
        <p class="xmt-short__tagline">{{ tagline }}</p>
        <p class="xmt-short__pitch">财经 · 科技 · 国内 · 国际——短平快可读，来源可核验。</p>
      {% else %}
        <p class="xmt-short__tagline xmt-short__tagline--flow">信流 · 上滑连读 · 来源可核</p>
      {% endif %}
      <p class="xmt-short__streak" data-xmt-streak hidden></p>
      <p class="xmt-short__sync" data-xmt-sync-status hidden></p>
    </div>

    <div class="xmt-short__mode-switch" role="tablist" aria-label="阅读模式">
      <a class="xmt-short__seg{% if mode == 'browse' %} is-active{% endif %}" href="{{ browse_url }}" role="tab" aria-selected="{{ mode == 'browse' ? 'true' : 'false' }}">速览</a>
      <a class="xmt-short__seg{% if mode == 'immerse' %} is-active{% endif %}" href="{{ immerse_url }}" role="tab" aria-selected="{{ mode == 'immerse' ? 'true' : 'false' }}">信流</a>
    </div>

    <div class="xmt-short__top-actions">
      <button type="button" class="xmt-short__mode-btn xmt-short__theme-btn" data-xmt-theme-toggle aria-label="{{ '切换白天 / 黑夜'|t }}" title="{{ '白天 / 黑夜'|t }}">
        <span data-xmt-theme-label>白天</span>
      </button>
      <a class="xmt-short__mode-btn" href="{{ today_url|default('/read/today') }}">今日</a>
      <a class="xmt-short__mode-btn xmt-short__later-open" href="/read/later" data-xmt-later-open>稍后</a>
      <a class="xmt-short__mode-btn" href="/trusted/search{% if level and level != 'trusted' %}?level={{ level }}{% endif %}">搜索</a>
      {% if official_media_url %}
        <a class="xmt-short__mode-btn" href="{{ official_media_url }}">官媒</a>
      {% endif %}
      <button type="button" class="xmt-short__mode-btn" data-xmt-unread-toggle aria-pressed="false">隐藏已读</button>
      <button type="button" class="xmt-short__mode-btn" data-xmt-clear-read hidden>清空已读</button>
      <button type="button" class="xmt-short__mode-btn" data-xmt-copy-share data-url="">复制本页</button>
      <a class="xmt-short__mode-btn" href="{{ rss_url }}" type="application/rss+xml" rel="alternate">RSS</a>
      <button type="button" class="xmt-short__mode-btn" data-xmt-copy-rss data-rss="{{ rss_url }}">复制 RSS</button>
    </div>
  </header>

  <nav class="xmt-short__filters" aria-label="{{ 'Trust filters'|t }}">
    {% for f in filters %}
      <a class="xmt-short__filter{% if f.active %} is-active{% endif %}" href="{{ f.url }}">{{ f.label }}</a>
    {% endfor %}
  </nav>

  {% if domain_rail and (domain_rail.primary or domain_rail.more or domain_rail.all) %}
    <div class="xmt-short__domains-wrap" data-xmt-domains{% if domain_rail.more_open %} data-open="1"{% endif %}>
      <nav class="xmt-short__domains xmt-short__domains--primary" aria-label="{{ '热门领域'|t }}">
        {% if domain_rail.all %}
          <a class="xmt-short__domain{% if domain_rail.all.active %} is-active{% endif %}" href="{{ domain_rail.all.url }}">{{ domain_rail.all.label }}</a>
        {% endif %}
        {% for d in domain_rail.primary %}
          <a class="xmt-short__domain{% if d.active %} is-active{% endif %}" href="{{ d.url }}"{% if d.hint %} title="{{ d.hint }}"{% endif %}>{{ d.label }}</a>
        {% endfor %}
        {% if domain_rail.more %}
          <button type="button" class="xmt-short__domain xmt-short__domain--more" data-xmt-domains-toggle aria-expanded="{{ domain_rail.more_open ? 'true' : 'false' }}">
            <span data-xmt-domains-label-more>{{ '更多'|t }}</span>
            <span data-xmt-domains-label-less hidden>{{ '收起'|t }}</span>
          </button>
        {% endif %}
      </nav>
      {% if domain_rail.more %}
        <nav class="xmt-short__domains xmt-short__domains--more" data-xmt-domains-panel aria-label="{{ '更多领域'|t }}"{% if not domain_rail.more_open %} hidden{% endif %}>
          {% for d in domain_rail.more %}
            <a class="xmt-short__domain{% if d.active %} is-active{% endif %}" href="{{ d.url }}"{% if d.hint %} title="{{ d.hint }}"{% endif %}>{{ d.label }}</a>
          {% endfor %}
        </nav>
      {% endif %}
    </div>
  {% elseif domain_filters|length > 1 %}
    <nav class="xmt-short__domains" aria-label="{{ 'Domain filters'|t }}">
      {% for d in domain_filters %}
        <a class="xmt-short__domain{% if d.active %} is-active{% endif %}" href="{{ d.url }}"{% if d.hint %} title="{{ d.hint }}"{% endif %}>{{ d.label }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  {% if source and clear_source_url %}
    <p class="xmt-short__source-bar">
      {{ '当前信源'|t }}：<strong>{{ source }}</strong>
      · <a href="{{ clear_source_url }}">{{ '清除信源筛选'|t }}</a>
    </p>
  {% endif %}

  {% if cards is empty %}
    <div class="xmt-short__empty">
      {% if empty_state %}
        <p class="xmt-short__empty-title">{{ empty_state.title }}</p>
        {% if empty_state.hint %}
          <p class="xmt-short__empty-hint">{{ empty_state.hint }}</p>
        {% endif %}
        {% if empty_state.related %}
          <p class="xmt-short__empty-related-label">{{ '同组相关领域'|t }}</p>
          <div class="xmt-short__empty-related">
            {% for r in empty_state.related %}
              <a class="xmt-short__domain" href="{{ r.url }}"{% if r.hint %} title="{{ r.hint }}"{% endif %}>{{ r.label }}</a>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <p>{{ '暂无短闻。可换信任级或领域再试。'|t }}</p>
      {% endif %}
      <div class="xmt-short__empty-actions">
        <a class="xmt-short__mode-btn" href="{{ empty_state.all_url|default('/read') }}">{{ '全部可信'|t }}</a>
        <a class="xmt-short__mode-btn" href="/read?level=official">{{ '仅官媒'|t }}</a>
        <a class="xmt-short__mode-btn" href="/trusted/search{% if level and level != 'trusted' %}?level={{ level }}{% endif %}">搜索</a>
        <a class="xmt-short__mode-btn" href="{{ today_url|default('/read/today') }}">今日</a>
        <a class="xmt-short__mode-btn" href="/read/later">稍后</a>
        {% if empty_state.ops_url %}
          <a class="xmt-short__mode-btn" href="{{ empty_state.ops_url }}">{{ '重测信源'|t }}</a>
        {% endif %}
        {% if empty_state.rss_url %}
          <a class="xmt-short__mode-btn" href="{{ empty_state.rss_url }}" type="application/rss+xml" rel="alternate">{{ '订阅 RSS'|t }}</a>
        {% endif %}
      </div>
    </div>
  {% elseif mode == 'immerse' %}
    <div class="xmt-short__progress" aria-live="polite"><span data-xmt-progress>1</span> / <span data-xmt-total>{{ cards|length }}</span></div>
    <div class="xmt-short__rail" id="xmt-short-rail" tabindex="0">
      {% for card in cards %}
        {% include '@xmt_trust_ui/xmt-short-read-card.html.twig' with { card: card, mode: 'immerse' } %}
      {% endfor %}
    </div>
    <div class="xmt-short__empty xmt-short__empty--hide-read" data-xmt-hide-read-empty hidden>
      <p>{{ '已隐藏全部已读条目。'|t }}</p>
      <div class="xmt-short__empty-actions">
        <button type="button" class="xmt-short__mode-btn" data-xmt-unread-toggle aria-pressed="true">显示已读</button>
        <button type="button" class="xmt-short__mode-btn" data-xmt-clear-read>清空已读</button>
        <a class="xmt-short__mode-btn" href="{{ browse_url }}">速览全部</a>
      </div>
    </div>
    <div class="xmt-short__swipe-hint" aria-hidden="true" data-xmt-swipe-hint>
      <span>上滑下一条</span>
    </div>
    <div class="xmt-short__hint" aria-hidden="true">上滑 · j/k · m/u · h 隐藏 · a 稍后 · o 原文 · e 详情 · t 今日 · i 模式 · f 搜索</div>
  {% else %}
    <div class="xmt-short__list" id="xmt-short-list">
      {% for card in cards %}
        {% include '@xmt_trust_ui/xmt-short-read-card.html.twig' with { card: card, mode: 'browse' } %}
      {% endfor %}
    </div>
    <div class="xmt-short__empty xmt-short__empty--hide-read" data-xmt-hide-read-empty hidden>
      <p>{{ '已隐藏全部已读条目。'|t }}</p>
      <div class="xmt-short__empty-actions">
        <button type="button" class="xmt-short__mode-btn" data-xmt-unread-toggle aria-pressed="true">显示已读</button>
        <button type="button" class="xmt-short__mode-btn" data-xmt-clear-read>清空已读</button>
        <a class="xmt-short__mode-btn" href="{{ immerse_url }}">进入信流</a>
      </div>
    </div>
    <div class="xmt-short__load-sent" id="xmt-short-sentinel" aria-hidden="true"></div>
    <div class="xmt-short__hint" aria-hidden="true">下滑 · j/k · m/u · i 信流 · a 稍后 · o 原文 · e 详情 · t 今日 · f 搜索</div>
  {% endif %}

  <aside class="xmt-short__later-panel" id="xmt-short-later" hidden>
    <div class="xmt-short__later-head">
      <strong>稍后再看</strong>
      <button type="button" class="xmt-short__mode-btn" data-xmt-later-close>关闭</button>
    </div>
    <ul class="xmt-short__later-list" data-xmt-later-list></ul>
  </aside>
</div>
