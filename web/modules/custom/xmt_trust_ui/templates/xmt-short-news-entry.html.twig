<div class="xmt-short-home xmt-short-home--entry" data-xmt-theme-root>
  <div class="xmt-short-home__bar">
    <p class="xmt-short-home__eyebrow">XMT · 核心入口</p>
    <button type="button" class="xmt-short-home__theme" data-xmt-theme-toggle aria-label="{{ '切换白天 / 黑夜'|t }}" title="{{ '白天 / 黑夜'|t }}">
      <span data-xmt-theme-label>白天</span>
    </button>
  </div>
  <div class="xmt-short-home__brand">{{ brand }}</div>
  <p class="xmt-short-home__text">{{ text }}</p>
  {% if hot_links %}
    <nav class="xmt-short-home__hot" aria-label="{{ '最热短闻'|t }}">
      {% for h in hot_links %}
        <a class="xmt-short-home__hot-link" href="{{ h.url }}">{{ h.label }}</a>
      {% endfor %}
    </nav>
  {% endif %}
  <div class="xmt-short-home__actions">
    <a class="xmt-short-home__btn xmt-short-home__btn--primary" href="{{ immerse_url }}">{{ '进入信流'|t }}</a>
    <a class="xmt-short-home__btn xmt-short-home__btn--ghost" href="{{ today_url }}">{{ '今日'|t }}</a>
    <a class="xmt-short-home__btn xmt-short-home__btn--ghost" href="{{ browse_url }}">{{ '速览'|t }}</a>
  </div>
</div>
