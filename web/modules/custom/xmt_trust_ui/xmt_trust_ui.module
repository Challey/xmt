/**
 * Implements hook_page_attachments().
 */
function xmt_trust_ui_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'xmt_trust_ui/trust_feed';
  $route = \Drupal::routeMatch()->getRouteName();
  if (in_array($route, [
    'xmt_trust_ui.short_read',
    'xmt_trust_ui.short_read_detail',
    'xmt_trust_ui.short_read_later',
    'xmt_trust_ui.short_read_today',
  ], TRUE)) {
    $attachments['#attached']['library'][] = 'xmt_trust_ui/short_read';
  }
}

/**
 * Implements hook_robots_alter().
 */
function xmt_trust_ui_robots_alter(array &$robots): void {
  if (!function_exists('xmt_trust_is_hub_site') || !xmt_trust_is_hub_site()) {
    return;
  }
  $sitemap = Url::fromRoute('xmt_trust_ui.trust_sitemap', [], ['absolute' => TRUE])->toString();
  if (empty($robots['Sitemap'])) {
    $robots['Sitemap'] = $sitemap;
    return;
  }
  if (!is_array($robots['Sitemap'])) {
    $robots['Sitemap'] = [$robots['Sitemap']];
  }
  if (!in_array($sitemap, $robots['Sitemap'], TRUE)) {
    $robots['Sitemap'][] = $sitemap;
  }
}

/**
 * Implements hook_preprocess_html().
 */
function xmt_trust_ui_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'xmt_trust_ui.short_read') {
    $mode = \Drupal::request()->query->get('mode', 'immerse');
    if ($mode !== 'browse') {
      $variables['attributes']['class'][] = 'xmt-mode-immerse';
    }
    $variables['attributes']['class'][] = 'xmt-short-news-page';
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function xmt_trust_ui_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if (!$entity instanceof Publisher || $view_mode !== 'full') {
    return;
  }
  if ($entity->get('status')->value !== 'approved') {
    return;
  }

  /** @var \Drupal\xmt_trust_ui\Service\PublisherPageBuilder $builder */
  $builder = \Drupal::service('xmt_trust_ui.publisher_page_builder');
  $build['xmt_trust_meta'] = $builder->buildMeta($entity);
  $build['xmt_feed_links'] = $builder->buildFeedLinks($entity);
  $build['xmt_articles'] = $builder->buildArticles($entity);
  $build['#attached']['library'][] = 'xmt_trust_ui/publisher_page';
  $build['#attached']['html_head_link'][] = [
    [
      'rel' => 'alternate',
      'type' => 'application/rss+xml',
      'title' => t('RSS'),
      'href' => Url::fromRoute('xmt_trust_ui.publisher_feed_rss', [
        'xmt_publisher' => $entity->id(),
      ], ['absolute' => TRUE])->toString(),
    ],
    TRUE,
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function xmt_trust_ui_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  if (!$node instanceof NodeInterface || !$node->hasField('field_trust_level')) {
    return;
  }
  if ($node->get('field_trust_level')->isEmpty()) {
    return;
  }
  $level = $node->get('field_trust_level')->value;
  $variables['xmt_trust_badge'] = [
    '#type' => 'html_tag',
    '#tag' => 'span',
    '#value' => xmt_trust_badge_label($level),
    '#attributes' => [
      'class' => ['xmt-trust-badge', xmt_trust_badge_class($level)],
    ],
  ];
  $variables['content']['xmt_trust_badge'] = $variables['xmt_trust_badge'];

  if (($variables['view_mode'] ?? '') !== 'full' || $node->isNew()) {
    return;
  }
  $variables['xmt_trust_verify_link'] = [
    '#type' => 'link',
    '#title' => t('核验溯源'),
    '#url' => Url::fromRoute('xmt_trust_ui.provenance_verify', ['node' => $node->id()]),
    '#attributes' => ['class' => ['xmt-trust-verify-link']],
  ];
  $variables['content']['xmt_trust_verify_link'] = $variables['xmt_trust_verify_link'];

  $byline = xmt_trust_ui_publisher_byline($node);
  if ($byline !== NULL) {
    $variables['xmt_trust_byline'] = $byline;
    $variables['content']['xmt_trust_byline'] = $byline;
  }
}

/**
 * Builds a publisher byline linking an article to its accountable subject.
 *
 * @param \Drupal\node\NodeInterface $node
 *   Article node.
 *
 * @return array|null
 *   Render array, or NULL when the article has no viewable publisher.
 */
function xmt_trust_ui_publisher_byline(NodeInterface $node): ?array {
  if (!$node->hasField('field_publisher') || $node->get('field_publisher')->isEmpty()) {
    return NULL;
  }
  $publisher = $node->get('field_publisher')->entity;
  if (!$publisher || !$publisher->access('view')) {
    return NULL;
  }

  return [
    '#type' => 'container',
    '#attributes' => ['class' => ['xmt-trust-byline']],
    'label' => [
      '#type' => 'html_tag',
      '#tag' => 'span',
      '#value' => t('发布主体：'),
    ],
    'link' => [
      '#type' => 'link',
      '#title' => $publisher->label(),
      '#url' => $publisher->toUrl(),
    ],
    '#cache' => ['tags' => $publisher->getCacheTags()],
  ];
}
