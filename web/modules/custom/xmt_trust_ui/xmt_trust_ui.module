<?php

/**
 * @file
 * XMT Trust UI module hooks.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\xmt_publisher\Entity\Publisher;

/**
 * Implements hook_page_attachments().
 */
function xmt_trust_ui_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'xmt_trust_ui/trust_feed';
}

/**
 * Implements hook_robots_alter().
 */
function xmt_trust_ui_robots_alter(array &$robots): void {
  if (!function_exists('xmt_trust_is_hub_site') || !xmt_trust_is_hub_site()) {
    return;
  }
  $sitemap = Url::fromRoute('xmt_trust_ui.trust_sitemap', [], ['absolute' => TRUE])->toString();
  if (empty($robots['Sitemap'])) {
    $robots['Sitemap'] = $sitemap;
    return;
  }
  if (!is_array($robots['Sitemap'])) {
    $robots['Sitemap'] = [$robots['Sitemap']];
  }
  if (!in_array($sitemap, $robots['Sitemap'], TRUE)) {
    $robots['Sitemap'][] = $sitemap;
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function xmt_trust_ui_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if (!$entity instanceof Publisher || $view_mode !== 'full') {
    return;
  }
  if ($entity->get('status')->value !== 'approved') {
    return;
  }

  /** @var \Drupal\xmt_trust_ui\Service\PublisherPageBuilder $builder */
  $builder = \Drupal::service('xmt_trust_ui.publisher_page_builder');
  $build['xmt_trust_meta'] = $builder->buildMeta($entity);
  $build['xmt_feed_links'] = $builder->buildFeedLinks($entity);
  $build['xmt_articles'] = $builder->buildArticles($entity);
  $build['#attached']['library'][] = 'xmt_trust_ui/publisher_page';
  $build['#attached']['html_head_link'][] = [
    [
      'rel' => 'alternate',
      'type' => 'application/rss+xml',
      'title' => t('RSS'),
      'href' => \Drupal\Core\Url::fromRoute('xmt_trust_ui.publisher_feed_rss', [
        'xmt_publisher' => $entity->id(),
      ], ['absolute' => TRUE])->toString(),
    ],
    TRUE,
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function xmt_trust_ui_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  if (!$node instanceof NodeInterface || !$node->hasField('field_trust_level')) {
    return;
  }
  if ($node->get('field_trust_level')->isEmpty()) {
    return;
  }
  $level = $node->get('field_trust_level')->value;
  $variables['xmt_trust_badge'] = [
    '#type' => 'html_tag',
    '#tag' => 'span',
    '#value' => xmt_trust_badge_label($level),
    '#attributes' => [
      'class' => ['xmt-trust-badge', xmt_trust_badge_class($level)],
    ],
  ];
  $variables['content']['xmt_trust_badge'] = $variables['xmt_trust_badge'];
}
