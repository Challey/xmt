<?php

/**
 * @file
 * XMT Trust module hooks.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeForm;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_presave().
 */
function xmt_trust_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'article') {
    return;
  }
  if (!$entity->hasField('field_trust_level')) {
    return;
  }

  $level = $entity->get('field_trust_level')->value;
  if ($level === NULL || $level === '') {
    $level = 'l0_aggregate';
    $entity->set('field_trust_level', $level);
  }

  if ($level === 'l2_enterprise' && $entity->hasField('field_publisher')) {
    $publisher = $entity->get('field_publisher')->entity;
    if (!$publisher || $publisher->get('status')->value !== 'approved') {
      throw new \Drupal\Core\Entity\EntityStorageException('L2 content requires an approved publisher.');
    }
  }

  if ($entity->hasField('field_provenance_hash')) {
    $existing_hash = $entity->get('field_provenance_hash')->value;
    if ($existing_hash !== NULL && $existing_hash !== '' && str_starts_with($existing_hash, 'dx:')) {
      return;
    }
    $source = '';
    if ($entity->hasField('field_source_url') && !$entity->get('field_source_url')->isEmpty()) {
      $source = $entity->get('field_source_url')->uri ?? $entity->get('field_source_url')->value ?? '';
    }
    $publisher_id = $entity->hasField('field_publisher') && !$entity->get('field_publisher')->isEmpty()
      ? (int) $entity->get('field_publisher')->target_id
      : 0;
    $payload = $source . '|' . $publisher_id . '|' . ($entity->getCreatedTime() ?: time());
    $entity->set('field_provenance_hash', hash('sha256', $payload));
  }
}

/**
 * Implements hook_form_alter().
 */

/**
 * Whether the current site is the XMT aggregation hub (xmt.pub).
 */
function xmt_trust_is_hub_site(): bool {
  $host = \Drupal::request()?->getHost() ?? '';
  return str_contains($host, 'xmt.pub') || str_contains($host, 'xmt.wsl');
}

function xmt_trust_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_object->getEntity();
  if ($node->bundle() !== 'article' || !isset($form['field_trust_level'])) {
    return;
  }

  $account = \Drupal::currentUser();
  if (!xmt_trust_is_hub_site() && !$account->hasPermission('administer xmt trust')) {
    $form['field_trust_level']['#disabled'] = TRUE;
    if (isset($form['field_publisher'])) {
      $form['field_publisher']['#disabled'] = TRUE;
    }
    $form['#after_build'][] = 'xmt_trust_vertical_readonly_after_build';
    return;
  }

  $allowed = [];
  if ($account->hasPermission('administer xmt trust') || $account->hasPermission('administer nodes')) {
    $allowed = array_keys(xmt_trust_level_allowed_values());
  }
  elseif ($account->hasPermission('publish xmt l2 enterprise')) {
    $allowed = ['l2_enterprise'];
  }
  elseif ($account->hasPermission('publish xmt l1 official')) {
    $allowed = ['l1_official'];
  }
  elseif ($account->hasPermission('publish xmt l0 aggregate')) {
    $allowed = ['l0_aggregate'];
  }

  if ($allowed === []) {
    unset($form['field_trust_level']);
    return;
  }

  $options = xmt_trust_level_allowed_values();
  $form['field_trust_level']['widget']['#options'] = array_intersect_key($options, array_flip($allowed));

  if ($account->hasPermission('publish xmt l2 enterprise') && isset($form['field_publisher'])) {
    $storage = \Drupal::entityTypeManager()->getStorage('xmt_publisher');
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('status', 'approved')
      ->condition('uid', $account->id())
      ->execute();
    if ($ids) {
      $form['field_publisher']['#access'] = TRUE;
    }
  }
}

/**
 * Keeps trust fields read-only after a vertical-site node form is built.
 *
 * Disabled widgets are not submitted, so the existing entity values remain
 * unchanged when an editor saves unrelated article fields.
 */
function xmt_trust_vertical_readonly_after_build(array $form, FormStateInterface $form_state): array {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm || $form_object->getEntity()->bundle() !== 'article') {
    return $form;
  }

  foreach (['field_trust_level', 'field_publisher'] as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#disabled'] = TRUE;
    }
  }

  return $form;
}

/**
 * Returns trust level labels.
 */
function xmt_trust_level_allowed_values(): array {
  return [
    'l0_aggregate' => t('L0 Aggregate'),
    'l1_official' => t('L1 Official'),
    'l2_enterprise' => t('L2 Enterprise'),
  ];
}

/**
 * Returns badge label for a trust level code.
 */
function xmt_trust_badge_label(string $level): string {
  return match ($level) {
    'l1_official' => (string) t('Official'),
    'l2_enterprise' => (string) t('Enterprise'),
    default => (string) t('Aggregate'),
  };
}

/**
 * Returns CSS class for a trust level code.
 */
function xmt_trust_badge_class(string $level): string {
  return match ($level) {
    'l1_official' => 'xmt-badge-l1',
    'l2_enterprise' => 'xmt-badge-l2',
    default => 'xmt-badge-l0',
  };
}

use Drupal\user\Entity\Role;

/**
 * Ensure article trust fields exist.
 */
function xmt_trust_ensure_fields(): void {
  $entity_type = 'node';
  $bundle = 'article';
  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $config_storage = \Drupal::entityTypeManager()->getStorage('field_config');

  $type_storage = \Drupal::entityTypeManager()->getStorage('node_type');
  if (!$type_storage->load($bundle)) {
    $type_storage->create([
      'type' => $bundle,
      'name' => 'Article',
      'description' => 'Syndicated and editorial articles.',
      'new_revision' => TRUE,
      'preview_mode' => DRUPAL_OPTIONAL,
      'display_submitted' => TRUE,
    ])->save();
  }

  $defs = [
    'field_trust_level' => [
      'type' => 'list_string',
      'label' => 'Trust level',
      'settings' => [
        'allowed_values' => xmt_trust_level_allowed_values(),
      ],
    ],
    'field_publisher' => [
      'type' => 'entity_reference',
      'label' => 'Publisher',
      'settings' => [
        'target_type' => 'xmt_publisher',
      ],
    ],
    'field_provenance_hash' => [
      'type' => 'string',
      'label' => 'Provenance hash',
      'settings' => ['max_length' => 128],
    ],
  ];

  foreach ($defs as $name => $info) {
    $storage_id = "$entity_type.$name";
    if (!$storage->load($storage_id)) {
      $values = [
        'field_name' => $name,
        'entity_type' => $entity_type,
        'type' => $info['type'],
        'cardinality' => 1,
        'translatable' => FALSE,
      ];
      if (!empty($info['settings'])) {
        $values['settings'] = $info['settings'];
      }
      $storage->create($values)->save();
    }

    $config_id = "$entity_type.$bundle.$name";
    if (!$config_storage->load($config_id)) {
      $config_storage->create([
        'field_name' => $name,
        'entity_type' => $entity_type,
        'bundle' => $bundle,
        'label' => $info['label'],
        'required' => FALSE,
        'translatable' => FALSE,
      ])->save();
    }
  }

  // Standard article body (text_with_summary); required for trusted-content push.
  if (!$config_storage->load('node.article.body')) {
    if (!$storage->load('node.body')) {
      $storage->create([
        'field_name' => 'body',
        'entity_type' => $entity_type,
        'type' => 'text_with_summary',
        'cardinality' => 1,
        'translatable' => TRUE,
        'settings' => [],
      ])->save();
    }
    $config_storage->create([
      'field_name' => 'body',
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'label' => 'Body',
      'required' => FALSE,
      'translatable' => TRUE,
    ])->save();
  }
}

/**
 * Ensure trust roles and public publisher permissions exist.
 */
function xmt_trust_ensure_roles(): void {
  $roles = [
    'xmt_official_editor' => [
      'label' => 'XMT Official Editor',
      'permissions' => [
        'publish xmt l1 official',
        'view xmt publisher',
        'create article content',
        'edit own article content',
        'delete own article content',
      ],
    ],
    'xmt_enterprise_publisher' => [
      'label' => 'XMT Enterprise Publisher',
      'permissions' => [
        'publish xmt l2 enterprise',
        'view xmt publisher',
        'apply xmt publisher',
        'create article content',
        'edit own article content',
        'delete own article content',
      ],
    ],
    'anonymous' => [
      'label' => NULL,
      'permissions' => [
        'view xmt publisher',
      ],
    ],
    'authenticated' => [
      'label' => NULL,
      'permissions' => [
        'view xmt publisher',
        'apply xmt publisher',
      ],
    ],
  ];

  $permission_handler = \Drupal::service('user.permissions');
  foreach ($roles as $id => $info) {
    $role = Role::load($id);
    if (!$role) {
      if ($info['label'] === NULL) {
        continue;
      }
      $role = Role::create(['id' => $id, 'label' => $info['label']]);
    }
    foreach ($info['permissions'] as $perm) {
      if ($permission_handler->getPermissions()[$perm] ?? NULL) {
        $role->grantPermission($perm);
      }
    }
    $role->save();
  }
}
