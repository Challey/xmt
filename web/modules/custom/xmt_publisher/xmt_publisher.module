<?php

/**
 * @file
 * XMT Publisher module hooks.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_theme().
 */
function xmt_publisher_theme(): array {
  return [
    'xmt_publisher' => [
      'render element' => 'elements',
    ],
  ];
}

/**
 * Prepares variables for publisher templates.
 */
function template_preprocess_xmt_publisher(array &$variables): void {
  $variables['attributes'] = new Attribute(['class' => ['xmt-publisher-page']]);
  $variables['content'] = [];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
  if (isset($variables['elements']['#xmt_publisher'])) {
    $variables['xmt_publisher'] = $variables['elements']['#xmt_publisher'];
    $variables['label'] = $variables['xmt_publisher']->label();
  }
}

/**
 * Implements hook_entity_presave().
 */
function xmt_publisher_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'xmt_publisher') {
    return;
  }
  if ($entity->isNew() && !$entity->getOwnerId()) {
    $entity->setOwnerId(\Drupal::currentUser()->id());
  }
}
